{
	"name": "@harperdb/http-router",
	"version": "0.4.2",
	"type": "commonjs",
	"main": "index.js",
	"description": "A Harper Component for routing requests using the Edgio/Layer0 router API",
	"keywords": [
		"harperdb",
		"caching"
	],
	"homepage": "https://github.com/HarperDB/http-router",
	"bugs": {
		"url": "https://github.com/HarperDB/http-router/issues",
		"email": "support@harperdb.io"
	},
	"author": {
		"name": "HarperDB",
		"email": "support@harperdb.io"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/HarperDB/http-router.git"
	},
	"license": "Apache-2.0",
	"files": [
		"config.yaml",
		"CustomCacheKey.js",
		"extension.js",
		"index.js",
		"routerState.js",
		"schema.graphql",
		"utils/"
	],
	"scripts": {
		"format": "prettier --write .",
		"pretest:integration": "node -e \"require('node:fs').rmSync('integrationTests/fixture/node_modules', { recursive: true, force: true })\" && npm install --prefix integrationTests/fixture",
		"test:integration": "harper-integration-test-run integrationTests/**/*.test.ts"
	},
	"dependencies": {
		"@harperdb/http-cache": "github:HarperFast/http-cache#v5-upgrade",
		"send": "^1.1.0"
	},
	"devDependencies": {
		"@harperdb/code-guidelines": "^0.0.2",
		"@harperfast/integration-testing": "^0.4.0",
		"harper": "^5.2.1",
		"harperdb-4.6": "npm:harperdb@4.6.1",
		"harperdb-4.7": "npm:harperdb@4.7.42",
		"prettier": "^3.3.3",
		"typescript": "^6.0.3"
	},
	"prettier": "@harperdb/code-guidelines/prettier"
}
